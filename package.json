{
  "name": "oiko",
  "private": true,
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @oiko/web dev",
    "build": "pnpm -r --filter './packages/*' build && pnpm --filter @oiko/web build",
    "test": "pnpm test:contracts && pnpm test:unit",
    "test:contracts": "cd contracts && cargo test --workspace",
    "test:unit": "vitest run",
    "e2e": "playwright test",
    "lint": "pnpm -r lint",
    "check:no-llm": "node scripts/check-no-llm.mjs",
    "check:copy": "node scripts/check-copy.mjs",
    "example:agent": "pnpm --filter @oiko/example-agent start"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/inter-tight": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@resvg/resvg-js": "^2.6.2",
    "opentype.js": "^2.0.0",
    "svgo": "^4.1.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5",
    "wawoff2": "^2.0.1"
  }
}
