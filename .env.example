# Oiko environment. Copy to .env (or apps/web/.env.local). Local-mode defaults below need no edits:
# `OIKO_NETWORK=local` talks to near-sandbox on 127.0.0.1:3030, uses mock tokens/lending under oiko.test.near and the
# built-in mock 1Click. The relayer key is read from .oiko/relayer.json (written by the local deploy script) when
# RELAYER_ACCOUNT_ID / RELAYER_PRIVATE_KEY are empty.

# --- Network --------------------------------------------------------------------------------------------------------
# local | testnet | mainnet
OIKO_NETWORK=local
# RPC. Defaults: local http://127.0.0.1:3030, testnet https://test.rpc.fastnear.com, mainnet https://rpc.mainnet.fastnear.com
OIKO_NODE_URL=
# Registry/root account. Defaults: local oiko.test.near, testnet oiko.testnet, mainnet oiko.near
OIKO_ROOT_ACCOUNT=
# Public URL of this deployment (used in /llms.txt, /openapi.json, the mock 1Click URL). Default http://localhost:3000
OIKO_PUBLIC_URL=

# --- Contracts (leave empty for defaults; "none" disables) ------------------------------------------------------------
# Defaults: local/testnet usdc.<root> / usdt.<root> (mock-ft, minted by the relayer);
# mainnet 17208628f84f5d6ad33f0da3bbbeb27ffcb398eac501a31bd6ad2011e36133a1 / usdt.tether-token.near
OIKO_USDC=
OIKO_USDT=
# Lending. Defaults: local/testnet lending.<root> (mock-lending); mainnet contract.main.burrow.near (Rhea)
OIKO_LENDING=
# ROSCA savings contract (internal name "ajo"). Default ajo.<root>
OIKO_AJO=
# Chain Signatures. Defaults: mainnet v1.signer, testnet v1.signer-prod.testnet, local none
OIKO_MPC_SIGNER=
# Trusted vault code hash (base58). The relayer also trusts registry.vault_code_hash() / trusted_code_hashes().
OIKO_VAULT_CODE_HASH=
# NEAR sent to each new name account by register_name, if the registry's config() doesn't expose account_funding.
OIKO_ACCOUNT_FUNDING_NEAR=
# NEAR the new account sends to its own savings account at creation (storage + lending registration). Must be <= RELAY_MAX_TRANSFER_NEAR.
OIKO_VAULT_FUNDING_NEAR=0.3

# --- Relayer (sponsors sign-up, vault creation, sync, top-ups, cron, mock 1Click mints) -------------------------------
RELAYER_ACCOUNT_ID=
# ed25519:<base58 secret key>. Server-only. Never expose to the browser.
RELAYER_PRIVATE_KEY=
# Optional near-cli style credentials file {account_id, private_key}. Default .oiko/relayer.json
RELAYER_KEY_FILE=
# Max NEAR a relayed vault-creation delegate may transfer (vault funding)
RELAY_MAX_TRANSFER_NEAR=1
# Top up an Oiko account when its available NEAR falls below this, by this amount
TOPUP_THRESHOLD_NEAR=0.15
TOPUP_AMOUNT_NEAR=0.15
# Global relayer spend per UTC day (deposits + transfers + gas estimate)
RELAYER_DAILY_BUDGET_NEAR=25

# --- NEAR Intents 1Click -----------------------------------------------------------------------------------------------
# Empty or "mock": local/testnet use the built-in mock at /api/mock-1click; mainnet uses https://1click.chaindefuser.com
ONECLICK_BASE_URL=
# Partner JWT from https://partners.near-intents.org (optional; without it 1Click may add a platform fee)
ONECLICK_JWT=

# --- Features (true/false) ---------------------------------------------------------------------------------------------
FEATURE_EARN=true
# ROSCA savings
FEATURE_AJO=true
FEATURE_MCP=true
# Default: on for local/testnet, off for mainnet
FEATURE_RESCUE=
FEATURE_INVEST=false
FEATURE_AJO_DAO=false
# Pay page: "Paying from a Gloam private balance?" (docs/PRIVACY.md). Off by default.
FEATURE_PRIVATE_PAY=false
# Optional RPCs for reading Gloam's cash-out fee (defaults: public Base and Ethereum nodes)
GLOAM_RPC_BASE=
GLOAM_RPC_ETHEREUM=

# --- Storage (optional) ------------------------------------------------------------------------------------------------
# Postgres for the agent access log, used NEP-413 nonces, push subscriptions and mock 1Click state.
# Empty = in-memory (resets on restart; not shared between serverless instances).
DATABASE_URL=

# --- Cron ---------------------------------------------------------------------------------------------------------------
# /api/cron requires "Authorization: Bearer $CRON_SECRET" (optional in local mode)
CRON_SECRET=

# --- Web push (optional; reminders are skipped when empty). Generate with: npx web-push generate-vapid-keys -----------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@oiko.app

# --- Agents (packages/mcp, examples/agents) -----------------------------------------------------------------------------
# Either the one-time connection string from Oiko → Agents → Connect …
OIKO_CONNECTION=
# … or the three parts:
OIKO_AGENT_KEY=
OIKO_VAULT_ID=
OIKO_API_URL=http://localhost:3000
# Scripted example: recipient for the demo payments (default: first NEAR account on the agent's allowlist)
OIKO_EXAMPLE_PAYEE=
# Telegram bot example
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=

# --- Counterparty check (docs/COUNTERPARTY.md; all optional) --------------------------------------------------------------
# NearBlocks API for account age, activity and contract deployments. Default: api.nearblocks.io (mainnet),
# api-testnet.nearblocks.io (testnet), none (local). Free tier is ~6 calls/min; results are cached per instance.
NEARBLOCKS_API_URL=
# Optional paid key, sent as "Authorization: Bearer <key>"
NEARBLOCKS_API_KEY=
# Set to off to skip NearBlocks entirely (age/activity then show as unknown → warn)
COUNTERPARTY_NEARBLOCKS=
# Agent payments to a receiver this account never paid, above this amount (USDC + USDT, decimal), are a warn. Default 10
COUNTERPARTY_FIRST_TIME_THRESHOLD=
# Distinct Oiko accounts that must report a receiver before it is blocked (seed list entries always block). Default 2: one report makes it a warning (agents must propose), two independent accounts block it.
COUNTERPARTY_BLOCK_REPORTS=
# Attack demo (examples/agents/attack-demo): API base override and the scam account to try (default: built-in demo entry)
OIKO_API=
OIKO_ATTACK_RECEIVER=
